rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsAlert() {
      return signedIn() && resource.data.userId == request.auth.uid;
    }

    // Each user has their own alert, including for one shared pantry item.
    match /expiry_alerts/{alertId} {
      allow create: if signedIn()
                    && request.resource.data.userId == request.auth.uid
                    && alertId == request.auth.uid + '_' + request.resource.data.itemId;

      allow read: if ownsAlert();

      allow update: if ownsAlert()
                    && request.resource.data.userId == request.auth.uid;

      allow delete: if ownsAlert();
    }

    // In-app notification center. Soft delete is an update; hard deletes stay closed.
    // Publish this block in Firebase Console. The catch-all rule below still
    // allows any signed-in user until that catch-all is removed or narrowed.
    match /users/{userId}/notifications/{notificationId} {
      allow read: if request.auth != null
                  && request.auth.uid == userId;

      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.userId == request.auth.uid;

      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == resource.data.userId;

      allow delete: if false;
    }

    // Remembers which pantry items were last seen above the low-stock
    // threshold so a low-stock alert is created only on a real crossing.
    match /users/{userId}/notificationMeta/{docId} {
      allow read, write: if request.auth != null
                          && request.auth.uid == userId;
    }

    // Rules are OR'd. This catch-all must not also match expiry_alerts, or a
    // signed-in user could read and write another user's alert.
    match /{collection}/{document=**} {
      allow read, write: if signedIn() && collection != 'expiry_alerts';
    }
  }
}